# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# GRIMA build output
/grima
/dist/

# Host baseline: machine specific, never shared
grima-baseline.json
*-baseline.json

# Decoy manifest: records the canary paths planted on this machine, so it is
# machine specific too.
grima-decoys.json

# Local run: the one-command launcher, its config and its watched directory are
# machine specific. Recreate the launcher from the README's PowerShell section.
/run-grima.ps1
/grima.toml
/grima-demo/

# Run output
*.log

# Evaluation harness output: the scenario scripts write their measurements here,
# and the tuned weight table is generated rather than authored.
/results/
/configs/*.tuned.toml

# Smoke test scratch
/.smoke/

# Sprint scratch: per-agent build output, configs and result files. A glob so a
# new sprint's directory is ignored without anyone remembering to add it.
/.sprint*/
/.audit/
